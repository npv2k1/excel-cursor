{
  "name": "excel-cursor",
  "version": "1.0.3",
  "description": "A powerful and flexible Excel manipulation library with cursor-based navigation",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "module": "./dist/esm/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/esm/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json && node ./scripts/finalize-build.js",
    "build:watch": "tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json --watch",
    "clean": "rimraf dist/",
    "dev": "nodemon",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "prepare": "npm run build",
    "package:smoke": "npm run build && node ./scripts/package-smoke.js",
    "example": "ts-node ./example/index.ts"
  },
  "keywords": [
    "excel",
    "exceljs",
    "spreadsheet",
    "cursor",
    "excel-manipulation",
    "typescript"
  ],
  "author": "npv2k1",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npv2k1/excel-cursor.git"
  },
  "bugs": {
    "url": "https://github.com/npv2k1/excel-cursor/issues"
  },
  "homepage": "https://github.com/npv2k1/excel-cursor#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/jest": "28.1.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "5.30.7",
    "@typescript-eslint/parser": "5.30.7",
    "cross-env": "^7.0.3",
    "eslint": "8.20.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "jest": "28.1.3",
    "nodemon": "^2.0.22",
    "prettier": "2.7.1",
    "rimraf": "^3.0.2",
    "ts-jest": "28.0.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "4.7.4"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.17",
      "brace-expansion@2": "2.1.3",
      "tmp": "0.2.7"
    }
  }
}
